generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  password  String

  ownedBands      Band[]
  roomMembers     RoomMember[]
  bandMemberships BandMember[]
}

model Band {
  id         String   @id @default(cuid())
  name       String
  ownerId    String
  inviteCode String?  @unique
  createdAt  DateTime @default(now())

  owner   User         @relation(fields: [ownerId], references: [id])
  members BandMember[]
  songs   Song[]
  rooms   Room[]
}

model BandMember {
  id        String   @id @default(cuid())
  bandId    String
  userId    String
  role      String   @default("MEMBER") // "OWNER" | "MEMBER"
  createdAt DateTime @default(now())

  band Band @relation(fields: [bandId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bandId, userId])
}

model Song {
  id       String  @id @default(cuid())
  title    String
  artist   String
  author   String?
  key      String?
  bpm      Int?
  duration Float
  lyrics   String?
  sections String? // JSON: Section[] — optional addon
  bandId   String
  originId String? // song this one was forked from, if any

  band   Band   @relation(fields: [bandId], references: [id], onDelete: Cascade)
  origin Song?  @relation("SongLineage", fields: [originId], references: [id], onDelete: SetNull)
  forks  Song[] @relation("SongLineage")
}

model Room {
  id           String   @id @default(cuid())
  code         String   @unique
  bandId       String
  leaderId     String
  setlist      String // JSON: string[] (song ids)
  activeSongId String?
  createdAt    DateTime @default(now())

  band    Band         @relation(fields: [bandId], references: [id], onDelete: Cascade)
  members RoomMember[]
}

model RoomMember {
  id       String   @id @default(cuid())
  roomId   String
  userId   String
  role     String   @default("MEMBER") // "LEADER" | "MEMBER"
  joinedAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
}
